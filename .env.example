# RPC endpoints used by verified enforcement.
ETH_RPC_URL=
SEPOLIA_RPC_URL=
CREDITCOIN_RPC_URL=

# Demo-only public RPC fallback.
AGENTFIREWALL_ALLOW_PUBLIC_RPC_FOR_DEMO=false

# Attestcoin / Creditcoin trust anchors.
SOURCE_CHAIN_KEY=1
AUTHORIZATION_SOURCE_ADDRESS=0x73fC164a9e7e7e3860E509e80B6A6ba838001275
AUTHORIZATION_SOURCE_RUNTIME_CODE_HASH=0xf77b4b45e6984902cf569605457d73cbfb69a0fbcc0e8f6e3d277a07bf9f1af8
AGENTFIREWALL_REGISTRY_ADDRESS=0x73fC164a9e7e7e3860E509e80B6A6ba838001275
AGENTFIREWALL_REGISTRY_RUNTIME_CODE_HASH=0x6670f9570d7f9c1db934e0b1a167fa676402a8148ec1130036baab81228a81b3
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/
CC3_SEMANTIC_GAS_LIMIT=

# Optional artifact locations.
AGENTFIREWALL_LIVE_DEPLOYMENT_FILE=build/live-deployment.json
AGENTFIREWALL_LIVE_AUTH_FILE=build/live-authorization.json
AGENTFIREWALL_LIVE_EVIDENCE_FILE=build/live-evidence.json

# Controller approval. Use a disposable testnet controller key that differs from the executor.
# `npm run controller:approve-live` derives the address/signature and stores only the public approval artifact.
AGENTFIREWALL_CONTROLLER_PRIVATE_KEY=
AGENTFIREWALL_TRUSTED_CONTROLLER=
AGENTFIREWALL_CONTROLLER_SIGNATURE=

# Fee policy.
AGENTFIREWALL_MAX_GAS_LIMIT=500000
AGENTFIREWALL_MAX_FEE_PER_GAS_WEI=
AGENTFIREWALL_MAX_PRIORITY_FEE_PER_GAS_WEI=
AGENTFIREWALL_MAX_TOTAL_FEE_WEI=

# Testnet orchestration.
AGENTFIREWALL_DEMO_RECIPIENT=
AGENTFIREWALL_DEMO_VALIDITY_SECONDS=21600
AGENTFIREWALL_LIVE_SEND=false
AGENTFIREWALL_MCP_ENABLE_SEND=false
SOURCE_CHAIN_TXN_HASH=
SOURCE_CHAIN_ID=11155111
B2_DEPLOY_TARGET=

# Disposable testnet key only. Never use a mainnet or custody key here.
AGENTFIREWALL_TESTNET_PRIVATE_KEY=

# Optional Proof Builder polling controls (milliseconds).
ATTESTCOIN_PROOF_POLL_MS=15000
ATTESTCOIN_PROOF_WAIT_TIMEOUT_MS=1200000
